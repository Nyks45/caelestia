#!/usr/bin/env python3
import json
import os
import subprocess
import tempfile
import time

STATE_FILE = "/tmp/caelestia-show-desktop.json"
MAPPING_FILE = "/tmp/caelestia-desktop-mapping.json"
WINDOWS_FILE = "/tmp/caelestia-desktop-windows.json"

def hyprctl(*args):
    subprocess.run(["hyprctl"] + list(args), capture_output=True)

def get_json(cmd):
    result = subprocess.run(["hyprctl", cmd, "-j"], capture_output=True, text=True)
    if result.returncode != 0:
        return None
    try:
        return json.loads(result.stdout)
    except json.JSONDecodeError:
        return None

def write_atomic(path, data):
    dir_ = os.path.dirname(path) or "/tmp"
    with tempfile.NamedTemporaryFile("w", dir=dir_, delete=False, suffix=".tmp") as f:
        json.dump(data, f)
        tmp = f.name
    os.replace(tmp, path)

def show_desktop():
    active = get_json("activeworkspace")
    if not active:
        return
    ws_id = active["id"]
    mon_id = active["monitorID"]
    mon_name = active["monitor"]

    clients = get_json("clients")
    if not clients:
        return
    windows = [
        (c["address"], ws_id, mon_id, mon_name, c.get("at", [0, 0]), c.get("size", [0, 0]), c.get("floating", False))
        for c in clients
        if c["workspace"]["id"] == ws_id and not c["hidden"] and c["mapped"]
    ]

    if not windows:
        return

    cmds = [f"dispatch movetoworkspacesilent name:desktop,address:{addr}" for addr, *rest in windows]
    hyprctl("--batch", ";".join(cmds))

    write_atomic(STATE_FILE, {"windows": windows, "workspace": ws_id})

    mapping = {addr.replace("0x", ""): str(orig_ws) for addr, orig_ws, *_ in windows}
    write_atomic(MAPPING_FILE, mapping)

    popout_windows = [
        {"address": c["address"].replace("0x", ""), "title": c.get("title", ""), "class": c.get("class", "")}
        for c in clients
        if c["workspace"]["id"] == ws_id and not c["hidden"] and c["mapped"]
    ]
    write_atomic(WINDOWS_FILE, popout_windows)

def restore():
    if not os.path.exists(STATE_FILE):
        return

    try:
        with open(STATE_FILE) as f:
            state = json.load(f)
    except (json.JSONDecodeError, OSError):
        try:
            os.remove(STATE_FILE)
        except OSError:
            pass
        return

    windows = state.get("windows", [])
    ws_id = state.get("workspace", 1)

    os.remove(STATE_FILE)
    for path in [MAPPING_FILE, WINDOWS_FILE]:
        try:
            os.remove(path)
        except FileNotFoundError:
            pass

    if not windows:
        return

    for entry in windows:
        addr = entry[0]
        orig_ws = entry[1] if len(entry) > 1 else ws_id
        orig_mon = entry[3] if len(entry) > 3 else None
        if orig_mon:
            hyprctl("dispatch", "focusmonitor", orig_mon)
        hyprctl("dispatch", "movetoworkspacesilent", f"{orig_ws},address:{addr}")
        time.sleep(0.05)

if __name__ == "__main__":
    if os.path.exists(STATE_FILE):
        restore()
    else:
        show_desktop()
